<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Couche INFRASTRUCTURE : les adaptateurs qui implémentent les ports de la couche
    application — énumération du système de fichiers, résolution des raccourcis .lnk par
    COM, lancement de processus, persistance JSON dans le dossier de données de
    l'utilisateur, journalisation.

    « net9.0-windows » est requis par l'interopérabilité COM (IShellLink) et par les API de
    processus propres à Windows. En revanche, aucune référence à System.Drawing : la
    fabrication des images appartient à la couche de présentation, seule concernée par
    l'affichage (voir Ui/Icons).
  -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>CSharpTrayShortcut.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CSharpTrayShortcut.Application\CSharpTrayShortcut.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
  </ItemGroup>

</Project>
